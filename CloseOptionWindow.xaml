<Window x:Class="CsAC_Client.CloseOptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭选项" 
        Height="200" Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <Grid Margin="15">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="您点击了关闭按钮，请选择操作：" 
                       FontSize="14" Margin="0,0,0,15"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button x:Name="BtnMinimize" Content="最小化到托盘" Width="120" Height="30" Click="BtnMinimize_Click" Margin="5,0"/>
                <Button x:Name="BtnExit" Content="直接退出" Width="80" Height="30" Click="BtnExit_Click" Margin="5,0"/>
            </StackPanel>
            <CheckBox x:Name="ChkRemember" Content="不再提醒，始终执行所选操作" 
                      HorizontalAlignment="Center" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>